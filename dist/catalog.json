          "anilist.co",
          "graphql.anilist.co",
          "s4.anilist.co"
        ],
        "authenticationModes": [
          "oauth2Implicit"
        ],
        "accountPolicy": {
          "authentication": {
            "mode": "oauth2Implicit",
            "authorizationURL": "https://anilist.co/api/v2/oauth/authorize",
            "callbackScheme": "manko",
            "callbackURL": "manko://oauth/anilist",
            "clientIDInfoPlistKey": "MANKO_ANILIST_OAUTH_CLIENT_ID",
            "responseType": "token",
            "scopes": []
          },
          "requests": [
            {
              "origin": "https://graphql.anilist.co",
              "pathPrefix": "/",
              "methods": [
                "POST"
              ],
              "operations": [
                "trackerSearch",
                "progress",
                "progressBatch",
                "collections"
              ],
              "bodyKind": "graphqlQuery"
            },
            {
              "origin": "https://graphql.anilist.co",
              "pathPrefix": "/",
              "methods": [
                "POST"
              ],
              "operations": [
                "update"
              ],
              "bodyKind": "graphqlMutation"
            }
          ]
        }
      },
      "moduleSHA256": "4b0971219543bc1f0cd57db2ae4bad40576c4276d4dc07678943b2e5840b7882",
