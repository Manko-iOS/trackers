      "sourceRevision": "main",
      "entryType": "extension",
      "kind": "tracker",
      "availability": "available",
      "permissions": {
        "values": [
          "authenticationHandoff",
          "network",
          "trackerUpdates"
        ]
      },
      "extension": {
        "apiVersion": "3.0",
        "runtime": "wasm",
        "moduleURL": "sources/AniList/3.0.0/main.wasm",
